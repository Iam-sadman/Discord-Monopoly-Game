# ==========================================
# Block Party Environment Configuration
# ==========================================

# Server Settings
PORT=3001
NODE_ENV=production
JWT_SECRET=super-secret-jwt-key-replace-in-production-with-random-32-chars

# PostgreSQL Database Configuration
# Leave blank to run with local in-memory transactional database
DATABASE_URL=postgres://blockparty:blockpartypass@localhost:5432/blockparty_db

# Discord Application Credentials (From https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-game-domain.com/api/auth/discord

# Authentication Mode
# Set to 'false' in strict Discord production
# Set to 'true' to allow testing in web browsers without Discord
ALLOW_DEV_AUTH=true
